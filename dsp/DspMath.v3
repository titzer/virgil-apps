// Elementary math for the DSP benchmarks: trig, atan2, pow, log10.
// Deterministic (pure Virgil), accurate to ~1e-15 relative over typical ranges.
// Depends on lib/math/Math.v3 for exp and log.
component DspMath {
	def PI = 3.14159265358979323846;
	def TWO_PI = 6.28318530717958647692;
	def HALF_PI = 1.57079632679489661923;
	def LN10 = 2.30258509299404568402;
	def LN2 = 0.69314718055994530942;

	// Reduce {x} to [-pi/4, pi/4] with quadrant {q}; returns (r, q).
	private def reduce(x: double) -> (double, int) {
		var k = double.round(x * (2.0 / PI));
		// Cody-Waite reduction with a 3-part pi/2
		var r = x - k * 1.5707963267341256e+0;
		r = r - k * 6.0771005065061922e-11;
		r = r - k * 2.0222662487959506e-21;
		return (r, int.truncd(k) & 3);
	}
	private def sinPoly(x: double) -> double {
		var z = x * x;
		return x + x * z * (-1.66666666666666324348e-1 + z * (8.33333333332248946124e-3 +
			z * (-1.98412698298579493134e-4 + z * (2.75573137070700676789e-6 +
			z * (-2.50507602534068634195e-8 + z * 1.58969099521155010221e-10)))));
	}
	private def cosPoly(x: double) -> double {
		var z = x * x;
		return 1.0 - 0.5 * z + z * z * (4.16666666666666019037e-2 + z * (-1.38888888888741095749e-3 +
			z * (2.48015872894767294178e-5 + z * (-2.75573143513906633035e-7 +
			z * (2.08757232129817482790e-9 + z * -1.13596475577881948265e-11)))));
	}
	def sin(x: double) -> double {
		var t = reduce(x), r = t.0;
		match (t.1) {
			0 => return sinPoly(r);
			1 => return cosPoly(r);
			2 => return -sinPoly(r);
			_ => return -cosPoly(r);
		}
	}
	def cos(x: double) -> double {
		var t = reduce(x), r = t.0;
		match (t.1) {
			0 => return cosPoly(r);
			1 => return -sinPoly(r);
			2 => return -cosPoly(r);
			_ => return sinPoly(r);
		}
	}
	def sinf(x: float) -> float { return float.roundd(sin(x)); }
	def cosf(x: float) -> float { return float.roundd(cos(x)); }
	def tan(x: double) -> double { return sin(x) / cos(x); }

	// atan for |x| <= 1 via argument halving and a series.
	private def atanSmall(x: double) -> double {
		// reduce: atan(x) = 2 atan(x / (1 + sqrt(1 + x^2)))
		var y = x / (1.0 + double.sqrt(1.0 + x * x));
		y = y / (1.0 + double.sqrt(1.0 + y * y));	// now |y| <= tan(pi/16) ~ 0.199
		var z = y * y, sum = 0.0, term = y;
		for (k = 0; k < 24; k++) {
			sum += term / (2 * k + 1);
			term = -term * z;
		}
		return 4.0 * sum;
	}
	def atan(x: double) -> double {
		if (x != x) return x;
		if (x > 1.0) return HALF_PI - atanSmall(1.0 / x);
		if (x < -1.0) return -HALF_PI - atanSmall(1.0 / x);
		return atanSmall(x);
	}
	def atan2(y: double, x: double) -> double {
		if (x > 0) return atan(y / x);
		if (x < 0) {
			if (y >= 0) return atan(y / x) + PI;
			return atan(y / x) - PI;
		}
		if (y > 0) return HALF_PI;
		if (y < 0) return -HALF_PI;
		return 0.0;
	}
	def atan2f(y: float, x: float) -> float { return float.roundd(atan2(y, x)); }

	def exp(x: double) -> double { return Math.exp(x); }
	def log(x: double) -> double { return Math.log(x); }
	def log10(x: double) -> double { return Math.log(x) / LN10; }
	def log2(x: double) -> double { return Math.log(x) / LN2; }
	def pow(x: double, y: double) -> double {
		if (y == 0) return 1.0;
		if (x == 0) return 0.0;
		return Math.exp(y * Math.log(x));
	}
	def expf(x: float) -> float { return float.roundd(Math.exp(x)); }
	def logf(x: float) -> float { return float.roundd(Math.log(x)); }
	def log10f(x: float) -> float { return float.roundd(log10(x)); }
	def powf(x: float, y: float) -> float { return float.roundd(pow(x, y)); }

	// Wrap a phase to (-pi, pi].
	def princarg(a: double) -> double {
		return a - TWO_PI * double.floor((a + PI) / TWO_PI);
	}
	def fmax(a: float, b: float) -> float { return if(a > b, a, b); }
	def fmin(a: float, b: float) -> float { return if(a < b, a, b); }
	def dmax(a: double, b: double) -> double { return if(a > b, a, b); }
	def dmin(a: double, b: double) -> double { return if(a < b, a, b); }
	def imax(a: int, b: int) -> int { return if(a > b, a, b); }
	def imin(a: int, b: int) -> int { return if(a < b, a, b); }
	def clampf(v: float, lo: float, hi: float) -> float { return if(v < lo, lo, if(v > hi, hi, v)); }
}
