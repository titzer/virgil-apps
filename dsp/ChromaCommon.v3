// Shared pieces of the beatmapper chroma (pitch-class profile) benchmarks:
// the chroma_fft radix-2 FFT (chroma_fft.h), window/normalisation helpers,
// the beat-synchronous driver (beat_chroma.cpp: attack skip, chroma_cosine),
// and a small harness that runs algorithms over a SynthSong and scores them
// against the ground-truth chords.

// Common signature of all chroma algorithms (chroma_algo.h):
//   (pcm, frame_count, channels, sample_rate, t_start, t_end, result[12])
// {minRoot}/{minTriad}: ground-truth accuracy (percent of beats) the algorithm is
// expected to reach on the synthetic songs; checked and printed by ChromaBench.
class ChromaAlgo(name: string, fn: (Array<float>, int, int, int, double, double, Array<float>) -> void,
	minRoot: int, minTriad: int) { }

component Chroma {
	def PIF = 3.14159265358979f;
	def NAMES = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];

	// Iterative Cooley-Tukey radix-2 in-place FFT (decimation-in-time), with
	// twiddles generated by a single-precision recurrence per stage (chroma_fft.h).
	def fft(re: Array<float>, im: Array<float>, n: int) {
		// Bit-reversal permutation
		var j = 0;
		for (i = 1; i < n; i++) {
			var bit = n >> 1;
			while ((j & bit) != 0) { j ^= bit; bit >>= 1; }
			j ^= bit;
			if (i < j) {
				var t = re[i]; re[i] = re[j]; re[j] = t;
				t = im[i]; im[i] = im[j]; im[j] = t;
			}
		}
		// Butterfly stages
		for (len = 2; len <= n; len <<= 1) {
			var ang = -2.0f * PIF / float.roundi(len);
			var wr = DspMath.cosf(ang), wi = DspMath.sinf(ang);
			var h = len >> 1;
			for (i = 0; i < n; i += len) {
				var cr = 1.0f, ci = 0.0f;
				for (k < h) {
					var a = i + k, b = a + h;
					var ur = re[a], ui = im[a];
					var vr = re[b] * cr - im[b] * ci;
					var vi = re[b] * ci + im[b] * cr;
					re[a] = ur + vr; im[a] = ui + vi;
					re[b] = ur - vr; im[b] = ui - vi;
					var nr = cr * wr - ci * wi;
					var ni = cr * wi + ci * wr;
					cr = nr; ci = ni;
				}
			}
		}
	}
	// Symmetric Hann window computed in single precision, as in the C++.
	def hann(n: int) -> Array<float> {
		var w = Array<float>.new(n);
		for (i < n) w[i] = 0.5f * (1.0f - DspMath.cosf(2.0f * PIF * float.roundi(i) / float.roundi(n - 1)));
		return w;
	}
	// C roundf(): round half away from zero.
	def roundf(x: float) -> int {
		var d: double = x;
		return if(d >= 0, int.truncd(double.floor(d + 0.5)), -int.truncd(double.floor(0.5 - d)));
	}
	def log2f(x: float) -> float { return float.roundd(DspMath.log2(x)); }
	def log1pf(x: float) -> float { return float.roundd(DspMath.log(1.0 + x)); }
	// Pitch class of a frequency, by midi rounding.
	def freqToPc(f: float) -> int {
		var midi = 12.0f * log2f(f / 440.0f) + 69.0f;
		return (roundf(midi) % 12 + 12) % 12;
	}
	// Sample range [fs, fe) for the time window, clamped to the buffer.
	def range(t0: double, t1: double, sr: int, frames: int) -> (int, int) {
		var fs = long.truncd(t0 * sr); if (fs < 0) fs = 0;
		var fe = long.truncd(t1 * sr); if (fe > frames) fe = frames;
		return (int.!(fs), int.!(fe));
	}
	// Mono mixdown of {n} frames from {pos}, multiplied by {win}, into re[]; zeroes im[].
	def monoWin(pcm: Array<float>, ch: int, pos: int, win: Array<float>, re: Array<float>, im: Array<float>, n: int) {
		var fch = float.roundi(ch);
		for (i < n) {
			var s = 0.0f;
			var base = (pos + i) * ch;
			for (c < ch) s += pcm[base + c];
			re[i] = (s / fch) * win[i];
			im[i] = 0.0f;
		}
	}
	// Normalise: peak -> 0 dB, -30 dB floor -> 0.
	def normDb(power: Array<double>, result: Array<float>) {
		var mx = 1e-30;
		for (i < 12) if (power[i] > mx) mx = power[i];
		for (i < 12) {
			var db = 10.0f * DspMath.log10f(float.roundd(power[i] / mx) + 1e-30f);
			var v = (db + 30.0f) / 30.0f;
			result[i] = if(v < 0.0f, 0.0f, if(v > 1.0f, 1.0f, v));
		}
	}
	def zero(r: Array<float>) { for (i < r.length) r[i] = 0.0f; }
	// Average of two chroma vectors, renormalised to peak 1 (the *_hps_peaks combos).
	def average(a: Array<float>, b: Array<float>, out: Array<float>) {
		var mx = 0.0f;
		for (i < 12) { out[i] = 0.5f * (a[i] + b[i]); if (out[i] > mx) mx = out[i]; }
		if (mx > 1e-9f) for (i < 12) out[i] /= mx;
	}
	// Cosine similarity of two chroma vectors (0 when either is silent).
	def cosine(a: Array<float>, b: Array<float>) -> float {
		var dot = 0.0f, na = 0.0f, nb = 0.0f;
		for (i < 12) { dot += a[i] * b[i]; na += a[i] * a[i]; nb += b[i] * b[i]; }
		if (na < 1e-12f || nb < 1e-12f) return 0.0f;
		return dot / float.sqrt(na * nb);
	}
	def argmax(v: Array<float>) -> int {
		var best = 0;
		for (i = 1; i < 12; i++) if (v[i] > v[best]) best = i;
		return best;
	}
	// Best-matching major/minor triad: root + (minor ? 12 : 0).
	def triad(v: Array<float>) -> int {
		var best = 0, bestScore = -1.0f;
		for (q < 2) {
			var third = if(q == 0, 4, 3);
			for (r < 12) {
				var s = v[r] + v[(r + third) % 12] + v[(r + 7) % 12];
				if (s > bestScore) { bestScore = s; best = r + 12 * q; }
			}
		}
		return best;
	}
	def template(chord: int) -> Array<float> {
		var t = Array<float>.new(12), r = chord % 12;
		t[r] = 1.0f;
		t[(r + if(chord >= 12, 3, 4)) % 12] = 1.0f;
		t[(r + 7) % 12] = 1.0f;
		return t;
	}
	def putChord(c: int) {
		System.puts(NAMES[c % 12]);
		if (c >= 12) System.putc('m');
	}
}

// beat_chroma.cpp: chroma of one beat interval, skipping the attack.
class BeatChromaParams {
	var attackMs = 60.0f;	// skip at least this much of the start of each beat
	var attackFrac = 0.15f;	// ... and at least this fraction of the interval

	def interval(algo: ChromaAlgo, pcm: Array<float>, frames: int, ch: int, sr: int,
			t0: double, t1: double, out: Array<float>) {
		Chroma.zero(out);
		if (pcm == null || t1 <= t0) return;
		var len = t1 - t0;
		var skip = attackMs * 0.001;
		if (attackFrac * len > skip) skip = attackFrac * len;
		if (skip > len * 0.5) skip = len * 0.5;
		algo.fn(pcm, frames, ch, sr, t0 + skip, t1, out);
	}
}

// Benchmark harness: beat-synchronous chroma for every algorithm over a song,
// printing the argmax pitch class and triad guess per beat, then a summary
// and explicit ground-truth checks ("check ...: PASS/FAIL").
// Arguments: <clip.wav> <tenths> [passes] [mask] [dump]
//   clip.wav  checked-in synthetic clip (inputs/Chroma-*.wav, see inputs/songs.list),
//             tiled to {tenths} tenths of a second, with ground-truth chords
//   passes    number of passes over the song (default 1; per-beat lines and
//             vector dumps are printed for the first pass only)
//   mask      bit mask selecting algorithms (default -1: all)
//   dump      any 5th argument prints every chroma vector (6 digits) for
//             comparison against the C++ reference harnesses in apps/Chroma*/ref
component ChromaBench {
	def PRINT_BEATS = 8;
	def PRINT_MAX = 32;
	var dump = false;
	var passes = 1;
	var mask = -1;

	def song(args: Array<string>, a4: double) -> SynthSong {
		if (args == null || args.length < 2) System.error("ChromaBench", "usage: <clip.wav> <tenths> [passes] [mask] [dump]");
		if (args.length > 2) passes = Int.parse(args[2]);
		if (args.length > 3 && args[3][0] != '-') mask = Int.parse(args[3]);
		dump = args.length > 4;
		var s = SynthSong.new();
		s.a4 = a4;
		s.seconds = double.!(Int.parse(args[1])) / 10.0;
		return s.loadTiled(args[0]);
	}
	// Prints "check <what> >= <pct>%: PASS (<count>/<n>)"; returns whether it passed.
	def check(name: string, what: string, count: int, n: int, pct: int) -> bool {
		var ok = count * 100 >= pct * n;
		System.puts("check ");
		System.puts(name);
		System.putc(' ');
		System.puts(what);
		System.puts(" >= ");
		DspOut.putl(pct);
		System.puts(if(ok, "%: PASS (", "%: FAIL ("));
		DspOut.putl(count);
		System.putc('/');
		DspOut.putl(n);
		System.puts(")\n");
		return ok;
	}
	// Returns true if all ground-truth checks pass.
	def run(s: SynthSong, all: Array<ChromaAlgo>) -> bool {
		var count = 0;
		for (i < all.length) if ((mask & (1 << byte.!(i))) != 0) count++;
		var algos = Array<ChromaAlgo>.new(count);
		count = 0;
		for (i < all.length) if ((mask & (1 << byte.!(i))) != 0) algos[count++] = all[i];
		var p = BeatChromaParams.new();
		var nb = s.beatTimes.length;
		var na = algos.length;
		var rootOk = Array<int>.new(na), triadOk = Array<int>.new(na);
		var cosSum = Array<double>.new(na), hash = Array<int>.new(na);
		var vs = Array<Array<float>>.new(na);
		for (a < na) vs[a] = Array<float>.new(12);
		var am = Array<int>.new(na), tr = Array<int>.new(na);
		var printed = 0;
		for (pass < passes) for (b < nb - 1) {
			var truth = s.chordAt[b];
			var tmpl = Chroma.template(truth);
			var miss = false;
			for (a < na) {
				var v = vs[a];
				p.interval(algos[a], s.pcm, s.frames, s.channels, s.sampleRate, s.beatTimes[b], s.beatTimes[b + 1], v);
				am[a] = Chroma.argmax(v);
				tr[a] = Chroma.triad(v);
				if (am[a] == truth % 12) rootOk[a]++;
				if (tr[a] == truth) triadOk[a]++;
				else miss = true;
				cosSum[a] += Chroma.cosine(v, tmpl);
				hash[a] = hash[a] * 31 + DspOut.checksum(v, 0, 12);
			}
			// Per-beat line "<beat> <truth>: <argmax>/<triad> ..." for the first
			// beats and for beats where some algorithm misses the chord (up to a limit).
			if (pass > 0) continue;
			if (b < PRINT_BEATS || (miss && printed < PRINT_MAX) || dump) {
				printed++;
				DspOut.putl(b);
				System.putc(' ');
				Chroma.putChord(truth);
				System.putc(':');
				for (a < na) {
					System.putc(' ');
					System.puts(Chroma.NAMES[am[a]]);
					System.putc('/');
					Chroma.putChord(tr[a]);
				}
				System.ln();
			}
			if (dump) {
				// "V <beat> <algo> v0 .. v11" lines, for comparison with the C++ reference
				for (a < na) {
					System.puts("V ");
					DspOut.putl(b);
					System.putc(' ');
					DspOut.putl(a);
					for (i < 12) { System.putc(' '); DspOut.putd(vs[a][i], 6); }
					System.ln();
				}
			}
		}
		var n = (nb - 1) * passes;
		for (a < na) {
			DspOut.label(algos[a].name);
			System.puts("root ");
			DspOut.putl(rootOk[a]);
			System.putc('/');
			DspOut.putl(n);
			System.puts(" triad ");
			DspOut.putl(triadOk[a]);
			System.putc('/');
			DspOut.putl(n);
			System.puts(" cos ");
			DspOut.putd(cosSum[a] / n, 3);
			System.puts(" checksum ");
			DspOut.putl(hash[a]);
			System.ln();
		}
		var ok = true;
		for (a < na) {
			if (!check(algos[a].name, "root accuracy", rootOk[a], n, algos[a].minRoot)) ok = false;
			if (!check(algos[a].name, "triad accuracy", triadOk[a], n, algos[a].minTriad)) ok = false;
		}
		return ok;
	}
}
